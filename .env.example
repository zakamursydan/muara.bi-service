# docker compose reads this file. Copy to .env and replace every value marked
# CHANGE-ME; .env itself is gitignored and never baked into an image.
#
# compose refuses to start while APP_SECRET_KEY, APP_ENCRYPTION_MASTER_KEY or
# DB_PASSWORD are unset, so there is no signing key shared with a public repo.

# ---------------------------------- SECRETS ----------------------------------
# JWT signing secret. Any long random string; rotating it logs everyone out.
APP_SECRET_KEY=CHANGE-ME-long-random-jwt-signing-secret

# AES-256 key for encrypted data-source and AI credentials. Exactly 32 bytes.
# WARNING: changing this after saving a connection makes those credentials
# undecryptable — re-enter them in the UI after a rotation.
APP_ENCRYPTION_MASTER_KEY=CHANGE-ME-32-bytes-master-key!!!

# ----------------------------------- APP -------------------------------------
LOG_LEVEL=info
# Origin used to build public share links; must match how the web app is reached.
APP_PUBLIC_BASE_URL=http://localhost:3000
# Host ports (the containers keep their own internal ports).
APP_WEB_PORT=3000
APP_API_PORT=8080

# ------------------------------ METADATA STORE ---------------------------------
DB_USERNAME=muara_user
DB_PASSWORD=CHANGE-ME-postgres-password
DB_NAME=muara_bi_db
DB_SCHEMA=public
DB_SSL_MODE=disable
# Port 5432 inside the network; this only publishes it to the host for psql.
DB_PUBLISH_PORT=5434
ENABLE_MIGRATIONS=true

# ---------------------------------- REDIS --------------------------------------
REDIS_PASSWORD=
REDIS_DB=0

# ----------------------------- ANALYTICAL ENGINE --------------------------------
# How many DuckDB sessions may run at once across the API and every worker
# replica. One session reserves up to DUCKDB_MAX_MEMORY, so size this from host
# memory: 2 fits a 4GB container, 4 needs a 8GB+ host.
DUCKDB_MAX_CONCURRENCY=2
# Memory budget of a single DuckDB session. Must carry a unit (B, KB, MB, GB, TB);
# the engine refuses to start on a bare number because DuckDB would read "2048"
# as bytes. Peak is this x DUCKDB_MAX_CONCURRENCY.
DUCKDB_MAX_MEMORY=2GB
# How long a caller queues for a free slot before the API answers 429.
DUCKDB_QUEUE_TIMEOUT_SECONDS=30
# Reclaim budget left behind by a killed process. Must exceed the longest query
# you intend to run, otherwise a slow live query loses its slot.
DUCKDB_SLOT_LEASE_SECONDS=120
# Asynq tasks one worker runs at once; tasks needing DuckDB still queue on the
# shared budget above, so this may be larger than DUCKDB_MAX_CONCURRENCY.
WORKER_CONCURRENCY=4
# The image already ships extensions at /opt/duckdb/extensions. Point elsewhere
# only when mounting a pre-bundled directory.
DUCKDB_EXTENSION_DIRECTORY=/opt/duckdb/extensions

# ------------------------------- AI CO-PILOT -----------------------------------
# Fallback only — an encrypted ai_settings key in the metadata DB wins.
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-3-5-sonnet-20241022
AI_FAST_MODEL=gemini-1.5-flash
AI_API_KEY=

# ----------------------------------- SMTP --------------------------------------
# Declared for the EMAIL alert channel, but no SMTP sender exists yet: these
# keys are not read by internal/config, and an EMAIL alert is recorded with a
# warning instead of being delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------- BUILD --------------------------------------
IMAGE_TAG=dev
# Base image mirrors, needed only when Docker Hub is unreachable from the build
# host, e.g. GO_IMAGE=public.ecr.aws/docker/library/golang:1.27-bookworm
# GO_IMAGE=golang:1.27-bookworm
# NODE_IMAGE=node:24-alpine
# Where the web container forwards /api/*. It is baked into the Next.js routes
# manifest at build time, so rebuilding web is required after changing it.
# WEB_API_BASE_URL=http://api:8080

# ------------------------------ OPENTELEMETRY ----------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=muara-bi-core
OTEL_DEPLOYMENT_ENVIRONMENT=development
