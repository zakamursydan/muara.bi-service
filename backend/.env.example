# ------------------------------------
# APP CONFIGURATION
# ------------------------------------
APP_HTTP_PORT=8080
LOG_LEVEL=info
APP_SECRET_KEY=muara-bi-super-secure-jwt-signing-secret-key-32b
APP_ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef

# ------------------------------------
# DATABASE CONFIGURATION (PostgreSQL Metadata)
# ------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=muara_bi_db
DB_SCHEMA=public
DB_SSL_MODE=disable
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
ENABLE_MIGRATIONS=true

# ------------------------------------
# REDIS CONFIGURATION (Asynq & Query Cache)
# ------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------
# OPENTELEMETRY (Optional Tracing)
# ------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=muara-bi-core
OTEL_DEPLOYMENT_ENVIRONMENT=development
